// The combined Transformidable + J. Lynne instance, in the J. Lynne Cloudflare
// account. It deploys as the existing `jlynne-cms` Worker, replacing the old
// J. Lynne library code there (its D1 and R2 stay, bound below for the
// import). Same code as wrangler.jsonc (the Transformidable account), which
// stays as it is until transformidablethinking.com moves over.
//
// Build:  npx opennextjs-cloudflare build --config wrangler.jlynne.jsonc
// Deploy: npx opennextjs-cloudflare deploy --config wrangler.jlynne.jsonc -- --keep-vars
// Steps and secrets: docs/jlynne-account-move.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jlynne-cms",
  "account_id": "eafd097bc9914edce898c4d47bd6d875",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jlynne-cms",
    },
    {
      // The briefings platform (repo phousecos/webinar), read for the public
      // feed behind the /briefings pages (src/lib/briefings.ts). A binding,
      // because a Worker can't reliably fetch another Worker on the same zone
      // by URL.
      "binding": "BRIEFINGS",
      "service": "briefings",
    },
    {
      // The Academy class platform (same repo, `academy` Worker,
      // live.betransformidable.com), read for course dates, seats and prices
      // on the /academy pages (src/lib/academy.ts). Deploy that Worker first:
      // a binding to a Worker that doesn't exist yet fails the deploy.
      "binding": "ACADEMY",
      "service": "academy",
    },
  ],
  "routes": [
    // The public website.
    { "pattern": "betransformidable.com", "custom_domain": true },
    { "pattern": "www.betransformidable.com", "custom_domain": true },
    // Former public address: pages redirect permanently to
    // betransformidable.com (next.config.mjs); /api still answers.
    // (transformidablethinking.com is parked, not served here.)
    { "pattern": "transformidable.media", "custom_domain": true },
    { "pattern": "www.transformidable.media", "custom_domain": true },
    // The admin (/admin) and API (/api), and the domain email is sent from.
    // Every other path redirects to the betransformidable.com home page
    // (next.config.mjs).
    { "pattern": "transformidable.net", "custom_domain": true },
    // jlynne.io is parked: not served here. Removing it from this list doesn't
    // detach it from the Worker; that's done in the dashboard
    // (docs/jlynne-account-move.md, "Parked domains").
  ],
  "vars": {
    // Where /api/assets/current points people for downloads: the Advisory
    // tools pages on the public site.
    "PUBLIC_DOWNLOAD_BASE_URL": "https://betransformidable.com/advisory/tools",
  },
  "r2_buckets": [
    {
      // Transformidable media and documents, copied from the Transformidable
      // account's bucket of the same name. Asset files go under asset-files/.
      "binding": "MEDIA_BUCKET",
      "bucket_name": "transformidable-media",
    },
    {
      // The jlynne.io bucket, read by the one-time import only.
      "binding": "JLYNNE_R2",
      "bucket_name": "jlynne-cms",
    },
  ],
  "d1_databases": [
    {
      // The jlynne.io database, read by the one-time import only.
      "binding": "JLYNNE_D1",
      "database_name": "jlynne-cms",
      "database_id": "d14351b1-38d3-4a9d-977e-c3cd86e08827",
    },
  ],
  "hyperdrive": [
    {
      // The J. Lynne account's Hyperdrive, pointing at the same Supabase
      // Session pooler URL as the Transformidable account's.
      "binding": "HYPERDRIVE",
      "id": "ccad495920d74de8933471385e2ba4b6",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres",
    },
  ],
  // The daily case-follow digest (worker.ts maps it to /api/cron/case-digest).
  // This Worker took it over from the Transformidable account's, which is
  // being retired.
  "triggers": { "crons": ["0 13 * * *"] },
  "observability": {
    "enabled": true,
  },
}
